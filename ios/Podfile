# Resolve react_native_pods.rb with node to allow for hoisting
node_binary = ENV['NODE_BINARY'] || 'node'
require Pod::Executable.execute_command(node_binary, ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

pod 'glog', :podspec => '../node_modules/react-native/third-party-podspecs/glog.podspec', :modular_headers => false

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'kadena' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :hermes_enabled => false
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false
    )
    
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] = 'YES'
        config.build_settings['CLANG_WARN_DOCUMENTATION_COMMENTS'] = 'NO'
        config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
        # fmt 11.0.2 fails to compile with Xcode 26's clang in C++20 mode
        # ("call to consteval function ... is not a constant expression").
        if target.name == 'fmt'
          config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
        # Some pods' resource bundles (RNSVGFilters, RNCAsyncStorage_resources)
        # declare iOS 12.4/13.4. Xcode 27 rejects targets below iOS 15.0, so
        # raise them to the app's minimum.
        target_ios = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if target_ios && Gem::Version.new(target_ios) < Gem::Version.new(min_ios_version_supported)
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios_version_supported
        end
      end
    end
  end
end